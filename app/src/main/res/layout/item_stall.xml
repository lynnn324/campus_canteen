<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/item_stall_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="6dp"
    android:background="?attr/colorSurface"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <!-- 档口图片：暂用通用餐盘图标，圆形主色浅底 -->
    <ImageView
        android:id="@+id/img_stall_icon"
        android:layout_width="68dp"
        android:layout_height="68dp"
        android:background="@drawable/bg_category_circle"
        android:importantForAccessibility="no"
        android:padding="14dp"
        android:src="@drawable/ic_meal" />

    <!-- 中间：店名 / 特色标签 / 月售·起送·配送 / 简介 -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_stall_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- 特色标签：代码里把 tags 用" · "拼起来，有数据才显示 -->
        <TextView
            android:id="@+id/tv_stall_tags"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_tag_outline"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingHorizontal="6dp"
            android:paddingVertical="1dp"
            android:textColor="?attr/colorPrimary"
            android:textSize="11sp" />

        <!-- 月售 · 起送价 · 配送费（免配送费时换成专门文案） -->
        <TextView
            android:id="@+id/tv_stall_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="11sp" />

        <!-- 档口简介：一行跑马，过长自动省略 -->
        <TextView
            android:id="@+id/tv_stall_intro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- 右侧：实时距离 + 预计时间 -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:gravity="end"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_stall_distance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="?attr/colorSecondary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tv_stall_eta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
