<?xml version="1.0" encoding="utf-8"?>
<!--
  ============ res/layout/item_dish.xml（菜品列表单项）============
  一行：菜品配图 + 菜名 + 分类/来源 + 单价 + 是否支持外卖/堂食小角标。
  菜名右侧的"来源"（来自哪个食堂）默认隐藏，只在分类页显示（档口详情页无需重复）。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/item_dish_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="6dp"
    android:background="?attr/colorSurface"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <!-- 菜品配图：圆角缩略图。图片资源名由数据里的 image 字段决定，代码里动态绑定 -->
    <ImageView
        android:id="@+id/img_dish"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:background="@drawable/bg_thumb"
        android:clipToOutline="true"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- 第一行：菜名 + 趣味标签（如"招牌必点"） -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_dish_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="菜品名"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- 趣味标签角标：有 label 才显示（代码里控制），默认隐藏 -->
            <TextView
                android:id="@+id/tv_dish_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@color/status_pending"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:text="标签"
                android:textColor="?attr/colorOnPrimary"
                android:textSize="11sp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- 菜品种类 -->
        <TextView
            android:id="@+id/tv_dish_type"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="主食"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="12sp" />

        <!-- 来源食堂：只在分类页显示（"来自 一粟轩"），档口详情页隐藏 -->
        <TextView
            android:id="@+id/tv_dish_source"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="11sp"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="end">

        <!-- 单价 -->
        <TextView
            android:id="@+id/tv_dish_price"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="¥0.0"
            android:textColor="?attr/colorSecondary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- 支持方式角标：外卖/堂食 -->
        <TextView
            android:id="@+id/tv_dish_mode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:textColor="?attr/colorOnPrimary"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- 收藏爱心：点击切换"收藏/取消收藏"这道菜（"我的→我的收藏"里能找回） -->
    <ImageView
        android:id="@+id/btn_fav_dish"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginStart="8dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/fav_toggle"
        android:padding="3dp"
        android:src="@drawable/ic_fav_off" />

    <!-- 加购按钮：点击后把这道菜加进购物车 -->
    <TextView
        android:id="@+id/btn_add_dish"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:background="?attr/colorPrimary"
        android:paddingHorizontal="14dp"
        android:paddingVertical="6dp"
        android:text="加购"
        android:textColor="?attr/colorOnPrimary"
        android:textSize="13sp"
        android:textStyle="bold" />
</LinearLayout>
