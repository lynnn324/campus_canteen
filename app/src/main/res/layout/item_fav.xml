<?xml version="1.0" encoding="utf-8"?>
<!--
  ============ res/layout/item_fav.xml（收藏菜品单项）============
  一行：配图 + 菜名/来源食堂 + 单价 + 取消收藏爱心。
  整行可点 → 跳到该菜所属档口详情页（在那里可加购）。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/item_fav_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="6dp"
    android:background="@drawable/bg_card"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <ImageView
        android:id="@+id/img_fav_dish"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/bg_thumb"
        android:clipToOutline="true"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_fav_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_fav_source"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_fav_price"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="?attr/colorSecondary"
        android:textSize="15sp"
        android:textStyle="bold" />

    <!-- 取消收藏：实心爱心，点了从收藏里移除（染成强调色，避免白底上看不见） -->
    <ImageView
        android:id="@+id/btn_unfav"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginStart="10dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/fav_remove"
        android:padding="3dp"
        android:src="@drawable/ic_fav_on"
        android:tint="?attr/colorSecondary" />
</LinearLayout>
