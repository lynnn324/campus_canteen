<?xml version="1.0" encoding="utf-8"?>
<!--
  ============ res/layout/fragment_cart.xml（购物车页）============
  结构：顶部标题 → 商品列表(RecyclerView，按档口分组) + 空态 → 底部结算栏。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?android:attr/colorBackground">

    <!-- 顶部标题 -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center"
        android:text="@string/tab_cart"
        android:textColor="?android:attr/textColorPrimary"
        android:textSize="17sp"
        android:textStyle="bold" />

    <!-- 列表区：购物车商品（按档口分组） -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_cart"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="16dp" />

        <!-- 空态：购物车没有东西时显示 -->
        <TextView
            android:id="@+id/tv_cart_empty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/cart_placeholder"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="15sp"
            android:visibility="gone" />
    </FrameLayout>

    <!-- 底部结算栏：总价 + 结算按钮 -->
    <LinearLayout
        android:id="@+id/ll_cart_bottom"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="?attr/colorSurface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="8dp">

        <TextView
            android:id="@+id/tv_cart_total"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/cart_total_default"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- 清空：清空购物车是购物车自己的操作，放在结算栏里最顺手 -->
        <TextView
            android:id="@+id/btn_clear_cart"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginEnd="8dp"
            android:gravity="center"
            android:minWidth="48dp"
            android:paddingHorizontal="12dp"
            android:text="@string/cart_clear"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/btn_checkout"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="?android:attr/textColorSecondary"
            android:gravity="center"
            android:paddingHorizontal="20dp"
            android:text="@string/cart_checkout"
            android:textColor="?attr/colorOnPrimary"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
