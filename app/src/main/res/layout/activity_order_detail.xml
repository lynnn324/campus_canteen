<?xml version="1.0" encoding="utf-8"?>
<!--
  ============ res/layout/activity_order_detail.xml（订单详情页）============
  结构：标题 → 订单号/方式/时间 → 时间轴(3步，进度条模拟状态流转) → 菜品明细 → 底部操作。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?android:attr/colorBackground">

    <!-- 标题栏：返回箭头 + 标题 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="?attr/colorPrimary"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="4dp">

        <ImageView
            android:id="@+id/btn_detail_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/btn_back"
            android:padding="12dp"
            android:src="@drawable/ic_arrow_back"
            android:tint="?attr/colorOnPrimary" />

        <TextView
            android:id="@+id/tv_detail_title"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/order_detail_title"
            android:textColor="?attr/colorOnPrimary"
            android:textSize="17sp"
            android:textStyle="bold" />

        <!-- 右侧占位：宽度与左侧箭头一致，让标题在整条标题栏中居中 -->
        <View
            android:layout_width="48dp"
            android:layout_height="48dp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- 订单号 / 方式 / 下单时间 -->
            <TextView
                android:id="@+id/tv_order_id"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tv_order_mode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tv_order_time"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="13sp" />

            <!-- 配送/取餐信息（外卖：配送费+送达时间；自取：取餐时间） -->
            <TextView
                android:id="@+id/tv_detail_delivery"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="13sp" />

            <!-- ============ 时间轴（状态流转模拟） ============
                 三列：圆点+文字，中间两条连线。
                 代码里按当前状态给圆点和连线染色：走到的变状态色，没走到保持浅灰。 -->
            <LinearLayout
                android:id="@+id/ll_timeline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- 第 1 步：待出餐 -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_circle_1"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:background="@drawable/bg_circle"
                        android:gravity="center"
                        android:text="1"
                        android:textColor="?attr/colorOnPrimary"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tv_step_label_1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/step_label_first"
                        android:textColor="?android:attr/textColorSecondary"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- 连线 1 -->
                <View
                    android:id="@+id/view_line_1"
                    android:layout_width="0dp"
                    android:layout_height="3dp"
                    android:layout_weight="1.2"
                    android:background="@color/timeline_inactive" />

                <!-- 第 2 步：配送中 / 待取餐 -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_circle_2"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:background="@drawable/bg_circle"
                        android:gravity="center"
                        android:text="2"
                        android:textColor="?attr/colorOnPrimary"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tv_step_label_2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/step_label_mid"
                        android:textColor="?android:attr/textColorSecondary"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- 连线 2 -->
                <View
                    android:id="@+id/view_line_2"
                    android:layout_width="0dp"
                    android:layout_height="3dp"
                    android:layout_weight="1.2"
                    android:background="@color/timeline_inactive" />

                <!-- 第 3 步：已完成 -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_circle_3"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:background="@drawable/bg_circle"
                        android:gravity="center"
                        android:text="3"
                        android:textColor="?attr/colorOnPrimary"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tv_step_label_3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/step_label_last"
                        android:textColor="?android:attr/textColorSecondary"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- 菜品明细标题 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/checkout_items_title"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <!-- 菜品明细容器：代码里逐行塞 -->
            <LinearLayout
                android:id="@+id/ll_detail_items"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical" />

            <!-- 合计 -->
            <TextView
                android:id="@+id/tv_detail_total"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="end"
                android:textColor="?attr/colorSecondary"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>
    </ScrollView>

    <!-- 底部操作：取消订单（待出餐才显示）/ 模拟状态流转 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="?attr/colorSurface"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp">

        <TextView
            android:id="@+id/btn_cancel_order"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@color/danger_bg"
            android:gravity="center"
            android:text="@string/btn_cancel_order"
            android:textColor="@color/danger_text"
            android:textSize="14sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/btn_next_status"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="?attr/colorPrimary"
            android:gravity="center"
            android:text="@string/btn_next_status"
            android:textColor="?attr/colorOnPrimary"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
