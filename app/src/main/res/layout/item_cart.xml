<?xml version="1.0" encoding="utf-8"?>
<!--
  ============ res/layout/item_cart.xml（购物车商品行）============
  一行：菜名+单价（左） / 减号、数量、加号、删除（右）。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/item_cart_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/colorSurface"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="16dp"
    android:paddingVertical="12dp">

    <!-- 左：菜名 + 单价 -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_cart_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="菜名"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tv_cart_price"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="¥0.0"
            android:textColor="?attr/colorSecondary"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 右：减号 - 数量 - 加号 - 删除 -->
    <TextView
        android:id="@+id/btn_cart_minus"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="@drawable/bg_search_box"
        android:gravity="center"
        android:text="-"
        android:textColor="?android:attr/textColorPrimary"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/tv_cart_qty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:text="1"
        android:textColor="?android:attr/textColorPrimary"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/btn_cart_plus"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="@drawable/bg_search_box"
        android:gravity="center"
        android:text="+"
        android:textColor="?attr/colorPrimary"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/btn_cart_delete"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:text="删"
        android:textColor="?android:attr/textColorSecondary"
        android:textSize="13sp" />
</LinearLayout>
