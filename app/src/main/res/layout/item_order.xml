<?xml version="1.0" encoding="utf-8"?>
<!--
  ============ res/layout/item_order.xml（订单列表卡片）============
  一张卡片：档口简述+总份数 / 金额 / 下单时间+状态色条 / 取消+详情按钮。
  卡片底色由代码按状态换（待出餐橙底、配送中青底、已完成绿底、已取消灰底）。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ll_order_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="6dp"
    android:background="?attr/colorSurface"
    android:orientation="vertical"
    android:padding="14dp">

    <!-- 第一行：档口简述 · 共X份   +  金额 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_order_summary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="档口"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_order_total"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="¥0.0"
            android:textColor="?attr/colorSecondary"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 第二行：下单时间   +   状态色条 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_order_time"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="时间"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tv_order_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:text="待出餐"
            android:textColor="?attr/colorOnPrimary"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- 第三行：取消（待出餐才显示）+ 查看详情 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="end"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btn_order_cancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:background="@color/danger_bg"
            android:paddingHorizontal="12dp"
            android:paddingVertical="5dp"
            android:text="@string/btn_cancel_order"
            android:textColor="@color/danger_text"
            android:textSize="12sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/btn_order_open"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/colorPrimaryLight"
            android:paddingHorizontal="12dp"
            android:paddingVertical="5dp"
            android:text="@string/btn_view_detail"
            android:textColor="?attr/colorPrimaryVariant"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
