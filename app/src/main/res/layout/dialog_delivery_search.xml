<?xml version="1.0" encoding="utf-8"?>
<!--
  ============ res/layout/dialog_delivery_search.xml（搜索送达位置弹窗）============
  结构：关键词输入框 → 搜索按钮 → 加载圈/提示 → 结果列表（点一行即选中）。
  说明：不再用预设地点，地点来自高德周边 POI 搜索结果。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <EditText
        android:id="@+id/et_spot_keyword"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/delivery_spot_search_hint"
        android:imeOptions="actionSearch"
        android:inputType="text"
        android:maxLines="1"
        android:textColorHint="?android:attr/textColorSecondary" />

    <Button
        android:id="@+id/btn_spot_search"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/btn_search_spot" />

    <ProgressBar
        android:id="@+id/pb_spot_search"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tv_spot_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="?android:attr/textColorSecondary"
        android:textSize="13sp"
        android:visibility="gone" />

    <ListView
        android:id="@+id/lv_spot_results"
        android:layout_width="match_parent"
        android:layout_height="260dp"
        android:layout_marginTop="8dp"
        android:divider="?android:attr/listDivider"
        android:dividerHeight="1dp" />
</LinearLayout>
