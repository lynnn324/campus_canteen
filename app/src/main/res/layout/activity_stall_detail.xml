<?xml version="1.0" encoding="utf-8"?>
<!--
  ============ res/layout/activity_stall_detail.xml（档口详情页）============
  结构：顶部标题 → 透明厨房(VideoView) → 菜品标题 → 菜品列表(RecyclerView)+空态。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?android:attr/colorBackground">

    <!-- 标题栏：返回箭头 + 档口名（右侧留同宽占位，保证标题视觉居中） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="?attr/colorPrimary"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="4dp">

        <ImageView
            android:id="@+id/btn_stall_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/btn_back"
            android:padding="12dp"
            android:src="@drawable/ic_arrow_back"
            android:tint="?attr/colorOnPrimary" />

        <TextView
            android:id="@+id/tv_shop_title"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:textColor="?attr/colorOnPrimary"
            android:textSize="18sp"
            android:textStyle="bold"
            android:text="档口详情" />

        <!-- 右侧占位：宽度与左侧箭头一致，让标题在整条标题栏中居中 -->
        <View
            android:layout_width="48dp"
            android:layout_height="48dp" />
    </LinearLayout>

    <!-- 透明厨房：本地厨房实况视频（素材放 res/raw/kitchen_live.mp4）
         用 TextureView 而非 VideoView：TextureView 把视频画进普通 View 树，
         在安卓模拟器上也能正常显示画面（VideoView 用的独立图层常渲染成黑块）。
         注意：TextureView 自身不支持 background，用外层 FrameLayout 提供黑底。 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:background="#000000">

        <TextureView
            android:id="@+id/video_kitchen"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- 角标：明确告诉用户这是"明厨亮灶"画面；接实时监控后文案会自动变成"直播中"。
             半透明黑底压在白字下，日夜模式都看得清。 -->
        <TextView
            android:id="@+id/tv_kitchen_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_margin="8dp"
            android:background="@drawable/bg_live_badge"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:text="@string/kitchen_badge_demo"
            android:textColor="@color/white"
            android:textSize="11sp" />
    </FrameLayout>

    <!-- 视频加载失败时兜底提示（覆盖在 VideoView 区域） -->
    <TextView
        android:id="@+id/tv_video_fallback"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:gravity="center"
        android:background="#000000"
        android:text="@string/kitchen_video_fallback"
        android:textColor="#AAAAAA"
        android:textSize="14sp"
        android:visibility="gone" />

    <!-- 菜品列表标题 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="4dp"
        android:text="@string/stall_dish_title"
        android:textColor="?android:attr/textColorPrimary"
        android:textSize="16sp"
        android:textStyle="bold" />

    <!-- 菜品列表 + 空态 + 悬浮购物车（美团式：底部浮起一条，随加购实时更新） -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_dish_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="96dp" />

        <TextView
            android:id="@+id/tv_dish_empty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/stall_dish_empty"
            android:textColor="?android:attr/textColorSecondary"
            android:visibility="gone" />

        <!-- 悬浮购物车条：购物车为空时整条隐藏 -->
        <LinearLayout
            android:id="@+id/ll_cart_bar"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_gravity="bottom"
            android:layout_margin="12dp"
            android:background="@drawable/bg_cart_bar"
            android:elevation="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp"
            android:visibility="gone">

            <!-- 圆形购物车图标 + 右上角件数角标 -->
            <FrameLayout
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_cart_circle">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/tab_cart"
                    android:src="@drawable/ic_cart_white" />

                <TextView
                    android:id="@+id/tv_cart_count"
                    android:layout_width="wrap_content"
                    android:layout_height="18dp"
                    android:layout_gravity="top|end"
                    android:background="@drawable/bg_badge"
                    android:gravity="center"
                    android:minWidth="18dp"
                    android:paddingHorizontal="4dp"
                    android:textColor="@color/white"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <!-- 中间：合计金额 + 件数说明 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_cart_total"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/cart_total_default"
                    android:textColor="?attr/colorPrimary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_cart_hint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- 右侧：去结算 -->
            <TextView
                android:id="@+id/btn_cart_checkout"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="@drawable/bg_pill_primary"
                android:gravity="center"
                android:paddingHorizontal="20dp"
                android:text="@string/cart_checkout"
                android:textColor="?attr/colorOnPrimary"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>