<?xml version="1.0" encoding="utf-8"?>
<!--
  ============ res/layout/activity_checkout.xml（确认订单页）============
  结构：标题 → 点餐方式/配送信息/倒计时/取餐时间 → 菜品明细 → 合计 → 提交订单。
  外卖模式显示：配送费 + 预计送达时间；
  自取模式显示：出餐倒计时（CountDownTimer）+ 取餐时间（TimePicker 选择）。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?android:attr/colorBackground">

    <!-- 标题栏：返回箭头 + 标题 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="?attr/colorPrimary"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="4dp">

        <ImageView
            android:id="@+id/btn_checkout_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/btn_back"
            android:padding="12dp"
            android:src="@drawable/ic_arrow_back"
            android:tint="?attr/colorOnPrimary" />

        <TextView
            android:id="@+id/tv_checkout_title"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/checkout_title"
            android:textColor="?attr/colorOnPrimary"
            android:textSize="17sp"
            android:textStyle="bold" />

        <!-- 右侧占位：宽度与左侧箭头一致，让标题在整条标题栏中居中 -->
        <View
            android:layout_width="48dp"
            android:layout_height="48dp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- 点餐方式 -->
            <TextView
                android:id="@+id/tv_checkout_mode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/checkout_mode_default"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- 外卖：配送费 + 预计送达；自取：出餐倒计时 -->
            <TextView
                android:id="@+id/tv_checkout_delivery"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="14sp" />

            <!-- 外卖：选择送达位置（预设校园地点列表，自取模式下隐藏） -->
            <LinearLayout
                android:id="@+id/ll_delivery_spot"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tv_delivery_spot"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/btn_choose_spot"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?attr/colorPrimaryLight"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:text="@string/btn_choose_spot"
                    android:textColor="?attr/colorPrimaryVariant"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- 自取：选择取餐时间（TimePicker） -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_checkout_pick_time"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/btn_choose_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?attr/colorPrimaryLight"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:text="@string/btn_choose_time"
                    android:textColor="?attr/colorPrimaryVariant"
                    android:textSize="13sp"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- 菜品明细标题 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/checkout_items_title"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <!-- 菜品明细容器：代码里逐行塞"菜名 xN ¥金额" -->
            <LinearLayout
                android:id="@+id/ll_checkout_items"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical" />

            <!-- 合计（含配送费） -->
            <TextView
                android:id="@+id/tv_checkout_total"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="end"
                android:text="@string/cart_total_default"
                android:textColor="?attr/colorSecondary"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>
    </ScrollView>

    <!-- 底部：提交订单 -->
    <TextView
        android:id="@+id/btn_submit"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="?attr/colorPrimary"
        android:gravity="center"
        android:text="@string/btn_submit"
        android:textColor="?attr/colorOnPrimary"
        android:textSize="16sp"
        android:textStyle="bold" />
</LinearLayout>
